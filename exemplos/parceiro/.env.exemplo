# Origem do host do Botzetta que enquadra a página (lista separada por vírgula). Obrigatória.
# Vira o frame-ancestors e o origensHost: em produção use SÓ https:// do Botzetta (nunca localhost).
BOTZETTA_HOST_URL=http://localhost:5173
# Núcleo do Botzetta (JWKS e GET /plataforma/v1/sessao).
NUCLEO_URL=http://localhost:8080
# Slug do app (o token "usuario" vem com aud app:<slug>).
APP_SLUG=meuapp
PORTA=4300
# client_id = APP_SLUG. Chave do app: gere com  npm run gerar-chave  (nunca versionar).
# No rascunho do portal informe jwksUrl = <seu domínio>/.well-known/jwks.json, a redirect URI
# <seu domínio>/botzetta/callback, a URL de instalação <seu domínio>/botzetta/instalar e a URL do
# webhook <seu domínio>/botzetta/webhook (as entregas são assinadas pelo núcleo; sem segredo).
APP_CHAVE_KID=
APP_CHAVE_PRIVADA=
BOTZETTA_REDIRECT_URI=https://app.seudominio.com/botzetta/callback
